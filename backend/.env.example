DATABASE_URL=postgres://user:pass@host:5432/dbname
JWT_SECRET=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model (check docs.claude.com for current names)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Your Netlify URL, no trailing slash. Comma-separate to allow several (e.g. + http://localhost:8888)
FRONTEND_URL=https://your-site.netlify.app
# Registration requires this code. Leave empty ONLY if you want open sign-ups.
INVITE_CODE=pick-a-secret-code
# Set to 1 if you use Render's EXTERNAL database URL
PGSSL=0
